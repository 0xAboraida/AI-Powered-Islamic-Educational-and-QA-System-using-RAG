{
  "rewrites": [
    {
      "source": "/api/turath-proxy/:path*",
      "destination": "/api/turath-proxy?__path=/:path*"
    },
    {
      "source": "/turath-proxy/:path*",
      "destination": "https://api.turath.io/:path*"
    },
    {
      "source": "/yt-community-proxy/:path*",
      "destination": "https://www.youtube.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
